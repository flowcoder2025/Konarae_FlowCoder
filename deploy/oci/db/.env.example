# /home/ubuntu/flowmate-db/.env  (mode 600, generated by install.sh on first run)
# Names only. Values: `openssl rand -hex 32` (URL-safe, used in connection strings).
# Never commit, print, or paste these values.

# postgres superuser; only used by the image entrypoint at first initdb
# (superuser is local-socket only; remote postgres is rejected in pg_hba.conf)
POSTGRES_SUPERUSER_PASSWORD=
# schema owner: restore + prisma db push, via SSH tunnel 127.0.0.1:5433 only
FLOWMATE_OWNER_PASSWORD=
# application role: Vercel (via PgBouncer :6432, TLS) and OCI workers (flowmate-db:5432)
FLOWMATE_APP_PASSWORD=
# PgBouncer auth_query role (plaintext copy rendered into pgbouncer/userlist.txt, 600, uid 70)
PGBOUNCER_AUTH_PASSWORD=

# Optional PgBouncer sizing (defaults shown)
# PGBOUNCER_MAX_CLIENT_CONN=500
# PGBOUNCER_DEFAULT_POOL_SIZE=15
# PGBOUNCER_MAX_DB_CONNECTIONS=30
