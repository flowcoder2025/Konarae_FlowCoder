;; FlowMate PgBouncer config template. Rendered by install.sh to
;; /home/ubuntu/flowmate-db/pgbouncer/pgbouncer.ini (owner uid 70, mode 600),
;; mounted at /etc/pgbouncer/pgbouncer.ini. Placeholders: upper-case names between at-signs (install.sh).
;; No secrets here; the only credential (pgbouncer_auth) is in userlist.txt.

[databases]
;; Only the application database. No `*` wildcard.
flowmate = host=@FLOWMATE_DB_IP@ port=5432 dbname=flowmate

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = 6432
;; No unix socket.
unix_socket_dir =

;; ---- Authentication -------------------------------------------------------
;; auth_type = hba: pgbouncer_hba.conf admits only flowmate_app -> flowmate over
;; TLS with scram-sha-256 and rejects every other user (incl. pgbouncer_auth,
;; which is in auth_file and would otherwise be able to log in on 6432).
;; flowmate_app's SCRAM verifier comes from auth_query; pgbouncer.get_auth()
;; returns only flowmate_app (login, non-superuser), so postgres / flowmate_owner
;; are unknown here even if the hba were loosened.
;; Server login for flowmate_app reuses the client's SCRAM keys (pass-through).
auth_type = hba
auth_hba_file = /etc/pgbouncer/pgbouncer_hba.conf
auth_file = /etc/pgbouncer/userlist.txt
auth_user = pgbouncer_auth
auth_dbname = flowmate
auth_query = SELECT username, password FROM pgbouncer.get_auth($1)

;; No admin console / stats users.
admin_users =
stats_users =

;; ---- Pooling (Vercel serverless: connection_limit=1 per function) ----------
pool_mode = transaction
max_client_conn = @MAX_CLIENT_CONN@
default_pool_size = @DEFAULT_POOL_SIZE@
min_pool_size = 0
reserve_pool_size = 5
reserve_pool_timeout = 3
max_db_connections = @MAX_DB_CONNECTIONS@
;; Protocol-level prepared statements (harmless with Prisma pgbouncer=true; protects
;; clients that forget it).
max_prepared_statements = 100
server_lifetime = 3600
server_idle_timeout = 300
server_connect_timeout = 5
server_login_retry = 3
query_wait_timeout = 60
client_login_timeout = 30
;; Prisma / JDBC-style startup parameters PgBouncer would otherwise reject.
ignore_startup_parameters = extra_float_digits,options

;; ---- TLS ----------------------------------------------------------------------
;; Clients must use TLS. Cert: Let's Encrypt db.jerome87.com (renew-cert.sh).
client_tls_sslmode = require
client_tls_cert_file = /etc/pgbouncer/tls/fullchain.pem
client_tls_key_file = /etc/pgbouncer/tls/privkey.pem
client_tls_protocols = tlsv1.2,tlsv1.3
client_tls_ciphers = secure
;; pgbouncer -> postgres stays on the docker-internal network.
server_tls_sslmode = disable

;; ---- Logging (stdout -> docker json-file, rotated) ---------------------------
log_connections = 1
log_disconnections = 0
log_pooler_errors = 1
