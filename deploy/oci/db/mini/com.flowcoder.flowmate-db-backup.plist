<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. install-launchd.sh replaces @HOME@ and installs it to
     ~/Library/LaunchAgents/com.flowcoder.flowmate-db-backup.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.flowcoder.flowmate-db-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@HOME@/.local/bin/flowmate-db-pull-backups.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>@HOME@</string>
    <key>LANG</key><string>en_US.UTF-8</string>
    <key>LC_ALL</key><string>en_US.UTF-8</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>5</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/flowmate-db-backup.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/flowmate-db-backup.log</string>
</dict>
</plist>
